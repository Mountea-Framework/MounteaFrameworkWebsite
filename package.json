{
  "name": "mountea-framework-website",
  "private": true,
  "scripts": {
    "build": "python script/build_combined.py --mode local --dialoguer-base /dialoguer/",
    "build:ci": "python script/build_combined.py --mode ci --dialoguer-base /dialoguer/",
    "dev": "python script/build_combined.py --mode local --dialoguer-base /dialoguer/ --skip-submodule-update && python script/dev_server.py --port 5173",
    "dev:fast": "python script/build_combined.py --mode local --dialoguer-base /dialoguer/ --skip-submodule-update --skip-mkdocs && python script/dev_server.py --port 5173"
  }
}
